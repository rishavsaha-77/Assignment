use serde::Deserialize;
use std::fs;

#[derive(Debug, Deserialize)]
struct Product {
    product_id: String,
}

fn main() {
    let data = fs::read_to_string("scraped_products_200 (1).json").expect("Failed to read file");
    let products: Vec<Product> = serde_json::from_str(&data).expect("Failed to parse json");

    let mut unique_products: Vec<Product> = Vec::new();

    for p in products {
       
        if !unique_products.iter().any(|u| u.product_id == p.product_id) {
            unique_products.push(p);
        }
    }

    println!("Total items: {}", unique_products.len());
}